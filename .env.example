# SheetSense AI — Environment Configuration Template (.env.example)
# Copy this file to .env and configure with your credentials:
#   cp .env.example .env
#
# NEVER commit the active .env file or real secrets to version control.

APP_ENV=development

# ── LLM Configuration ────────────────────────────────────────────────────────
# Get your Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# (Optional) OpenAI API Key fallback if configured
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# ── Google Sheets & Cloud Service Account ────────────────────────────────────
# URL of your Google Spreadsheet (Share with service account email as Editor)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_spreadsheet_id_here/edit

# Local development option. Production should inject GCP_CREDENTIALS_JSON
# through the deployment platform's secret manager.
GOOGLE_CREDS_PATH=credentials.json

# (Alternative) Inline GCP Service Account JSON string (useful for Docker/Cloud deployments)
# GCP_CREDENTIALS_JSON='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'

# ── Application Gateway & Security ───────────────────────────────────────────
# Authentication never disables itself silently. Plaintext configuration is
# supported for local development only and is hashed immediately in memory.
SHEETSENSE_API_KEY=replace-with-a-secure-random-token

# Production: remove SHEETSENSE_API_KEY and configure its SHA-256 digest.
# Generate with:
# python -c "import hashlib,getpass; print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
# SHEETSENSE_API_KEY_HASH=<64-character-sha256-digest>

# Optional multi-key production configuration:
# SHEETSENSE_API_KEYS_JSON=[{"id":"ops","key_sha256":"<digest>","roles":["viewer","editor","approver","admin"]}]

# Explicit emergency-only local switch. This is rejected in production.
ALLOW_INSECURE_NO_AUTH=false

# Comma-separated browser origins. Wildcards are rejected.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8501

# Demo mode must be explicitly enabled and must never represent simulated data
# as live system output.
DEMO_MODE=false

# ── Distributed Session & State Storage ─────────────────────────────────────
# Redis connection URL for multi-worker distributed session memory & rate limiting.
# If Redis is unavailable, the application automatically falls back to in-memory storage.
REDIS_URL=redis://localhost:6379/0

# SQLite database file for confirmation gate audit logs and benchmark tracking
SQLITE_DB_PATH=sheetsense.db
