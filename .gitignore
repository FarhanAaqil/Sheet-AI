.env
*.env
credentials.json
service_account.json
*credentials*.json
*secret*.json
token.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

# ── Cache & Temp ──────────────────────────────────────────────────────────────
cache/
.cache/
*.log
*.tmp
*.temp
__pycache__/

# ── Docker ───────────────────────────────────────────────────────────────────
*.tar
chatbot-sheet.tar

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS ───────────────────────────────────────────────────────────────────────
desktop.ini
ehthumbs.db
